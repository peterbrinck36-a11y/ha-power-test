# ── Database ────────────────────────────────────────────────────────────────
# SQLite file (created + migrated automatically on first start).
# Local default: ./data/marina.db — Docker default: /app/data/marina.db
DATABASE_PATH=./data/marina.db

# ── Home Assistant (server-side only, NEVER exposed to the browser) ─────────
# Base URL of your Home Assistant instance, e.g. http://homeassistant.local:8123
HA_URL=
# Long-lived access token (HA → Profile → Security → Create token)
HA_TOKEN=
# Optional: serve states from a JSON file (array of HA state objects) instead
# of live HA — used for offline development and Playwright tests.
# Example: HA_MOCK_FILE=docs/ha-sample.json
HA_MOCK_FILE=

# ── Initial admin ───────────────────────────────────────────────────────────
# Seeded automatically on first start if no admin user exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ── Sessions ────────────────────────────────────────────────────────────────
# HS256 signing secret. REQUIRED in production.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Cookie Secure flag:
#   auto (default) → secure only when x-forwarded-proto is https (works both
#                    behind a reverse proxy and on http://localhost:3000)
#   true           → always secure
#   false          → never secure
COOKIE_SECURE=auto

# Failed-login attempts allowed per IP per 15 minutes (default 10).
# Override only for load-test/E2E environments.
MAX_LOGIN_ATTEMPTS=10
